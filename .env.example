# Example environment variables file for Packer build
# Copy this file to .env and fill in your values
# Source this file before running Packer: source .env

# ============================================================================
# Azure Credentials (required for Azure builds)
# ============================================================================
export AZURE_CLIENT_ID="your-client-id"
export AZURE_CLIENT_SECRET="your-client-secret"
export AZURE_SUBSCRIPTION_ID="your-subscription-id"
export AZURE_TENANT_ID="your-tenant-id"

# ============================================================================
# Superset Credentials (REQUIRED)
# ============================================================================
# Generate a secure secret key (example below uses Python)
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
export SUPERSET_SECRET_KEY="your-secure-random-secret-key-at-least-32-chars"

# PostgreSQL database password
export SUPERSET_DB_PASSWORD="your-secure-database-password"

# Superset admin user credentials
export SUPERSET_ADMIN_USERNAME="admin"
export SUPERSET_ADMIN_PASSWORD="your-secure-admin-password"
export SUPERSET_ADMIN_EMAIL="admin@example.com"

# ============================================================================
# Usage
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and set your actual values
# 3. Source the file: source .env
# 4. Run Packer: packer build superset.pkr.hcl

# ============================================================================
# CI/CD Pipeline Usage
# ============================================================================
# In your CI/CD pipeline (GitHub Actions, Azure DevOps, etc.):
# 1. Store credentials as secret variables in your pipeline
# 2. The pipeline will automatically set them as environment variables
# 3. Packer will pick them up from the environment

# Example for GitHub Actions:
# - Add secrets in repository settings
# - Reference them in workflow:
#   env:
#     SUPERSET_SECRET_KEY: ${{ secrets.SUPERSET_SECRET_KEY }}
#     SUPERSET_DB_PASSWORD: ${{ secrets.SUPERSET_DB_PASSWORD }}
#     SUPERSET_ADMIN_PASSWORD: ${{ secrets.SUPERSET_ADMIN_PASSWORD }}

# Example for Azure DevOps:
# - Add secret variables in pipeline
# - They will be automatically exported as environment variables

# ============================================================================
# Security Best Practices
# ============================================================================
# - NEVER commit .env file to version control
# - Use strong, randomly generated passwords (min 20 characters)
# - Use different credentials for dev, staging, and production
# - Rotate credentials regularly
# - Use a password manager or secrets vault
# - In production, use managed identities or Key Vault when possible
