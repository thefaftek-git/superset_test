  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: superset-vm
    username: superset
    password: $6$rounds=4096$saltsalt$YQz5Z9c9rlF.A7bCMvJYvzJXJzG2wKnXKJWJxVYxVGQb7wZl4l4rNJ4dJ7K1J4J7K1J4J7K1J4J7K1J4J7K1J1
